@ test_fun3 :: |a:int|void:
	ahoy |"",a|;
	? switch day_of_week on
	? 	"Monday" : print|"Start of the week"|
	? 	"Friday" : print|"End of the week"|
	? 	_: print	|"mid week"|
	day_of_week: "Wednesday";
	switch day_of_week:
		on "Monday" ,"Tuesday",1:
			print|"start of the wek"|
			print|"Start of the week"|
			print|"Start of the week"|
		on "Friday" :
			print|"End of the week"|
			print|"End of the week"|
		_:
			print	|"mid week"|
			print	|"mid week"|
			print	|"mid week"|
	$

	day_of_week: "Wednesday";
	switch day_of_week:
		on "Monday" : 29
		on "Friday" : "jkljlk"
		_: print	|"mid week"|
	$

	day_of_week_message :int= switch day_of_week: ? as no type specified therefore should infer type therefore all returns need to be of same type
		on "Monday" : 88
		on "Friday" : 90
		on "Thursday": 90
		on "Tuesday" : 89
		on "Saturday" : 90
		_: 980
	$

	day_of_week_message2 :string = switch day_of_week:
		on "Mondy" : "Start of the week"
		on "Tuesday" :"function"  ? should give linting error expected type string as return
		on "Thursday" : "Almost weekend"? should give linting error expected type string as return
		on "Friday" : "End of the week"
		on "Saturday" : returns_two_things	|| ? should give linting error expected type string as return
		_: "mid week"
	$
	day_of_week_message3,day_number :(string, int) = switch day_of_week:
		on "Monday" : "Start of the week",1
		on "Sarturday" : "Start of the week" ,2? expected return values (string,int) got (int,string)
		on "Tuesday" : "Start of the week",32 ? expected two return values (string,int) got 1
		on "Friday" : "End of the week",5 ? expected two return values (string,int) got 3
		_: "mid week",3
	$
$

